@model SistemaPlanificacionSNP.Web.Models.ObjetivoMacroEditViewModel

@{
    ViewData["Title"] = "Editar Objetivo Estratégico Nacional";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="mb-1 fw-bold text-dark"><i class="fas fa-pen-to-square me-2 text-primary"></i>Editar Objetivo Estratégico Nacional</h3>
            <p class="text-muted mb-0 text-uppercase tracking-wider text-xs fw-bold">PND-@Model.PlanNacionalId · OBJ-@Model.ObjetivoEstrategicoId</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a href="/macroplanificacion/planes/@Model.PlanNacionalId" class="btn btn-light border shadow-sm px-4 fw-medium text-secondary">
                <i class="fas fa-arrow-left me-2"></i>Volver al Detalle
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-warning border-0"></div>
                    }

                    <form method="post" action="/macroplanificacion/planes/@Model.PlanNacionalId/objetivos/@Model.ObjetivoEstrategicoId/editar">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PlanNacionalId" />
                        <input type="hidden" asp-for="ObjetivoEstrategicoId" />

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label asp-for="Codigo" class="form-label fw-medium text-sm"></label>
                                <input asp-for="Codigo" class="form-control fw-bold text-primary bg-light" style="text-transform: uppercase;" />
                                <span asp-validation-for="Codigo" class="text-danger text-sm"></span>
                            </div>

                            <div class="col-md-9">
                                <label asp-for="Nombre" class="form-label fw-medium text-sm"></label>
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger text-sm"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Descripcion" class="form-label fw-medium text-sm"></label>
                                <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Descripcion" class="text-danger text-sm"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a href="/macroplanificacion/planes/@Model.PlanNacionalId" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-secondary px-4 shadow-sm">
                                <i class="fas fa-save me-1"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
