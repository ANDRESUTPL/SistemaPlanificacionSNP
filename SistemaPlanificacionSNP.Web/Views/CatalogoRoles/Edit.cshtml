@model SistemaPlanificacionSNP.Web.Models.CatalogoRolEditViewModel

@{
    ViewData["Title"] = "Editar Rol";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="mb-1 fw-bold text-dark"><i class="fas fa-pen me-2 text-primary"></i>Editar Rol</h3>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">Actualiza datos del rol y su estado operativo.</p>
        </div>
        <a href="/seguridad/catalogo-roles" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fas fa-arrow-left me-1"></i>Volver
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form method="post" action="/seguridad/catalogo-roles/@Model.RolId/editar">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RolId" />

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-medium"></label>
                    <input asp-for="Nombre" class="form-control" maxlength="100" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-medium"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="4" maxlength="500"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="Activo" class="form-check-input" type="checkbox" />
                    <label asp-for="Activo" class="form-check-label"></label>
                </div>

                <div class="card border-0 bg-light bg-opacity-50 mb-4">
                    <div class="card-header bg-white border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-table-cells me-2 text-primary"></i>Matriz de permisos por pantalla</h6>
                                <small class="text-muted">Ajusta aquí los accesos del rol por pantalla.</small>
                            </div>
                            <span class="badge rounded-pill text-bg-light border">@Model.PermisosPantalla.Count pantalla(s)</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light bg-opacity-50">
                                    <tr>
                                        <th class="ps-4 border-0 text-xs text-muted fw-bold">PANTALLA</th>
                                        <th class="border-0 text-xs text-muted fw-bold text-center">LECTURA</th>
                                        <th class="border-0 text-xs text-muted fw-bold text-center">CREACIÓN</th>
                                        <th class="border-0 text-xs text-muted fw-bold text-center">EDICIÓN</th>
                                        <th class="pe-4 border-0 text-xs text-muted fw-bold text-center">ELIMINACIÓN</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        // 1. Indexamos la lista para mantener la posición del Model Binding intacta
                                        var listaIndexada = Model.PermisosPantalla
                                            .Select((item, index) => new { Item = item, Index = index })
                                            .ToList();

                                        // 2. Buscamos los padres (aquellos cuyo PantallaPadrId es null o 0)
                                        var padres = listaIndexada
                                            .Where(x => x.Item.PantallaPadrId == null || x.Item.PantallaPadrId == 0)
                                            .ToList();

                                        var procesados = new HashSet<int>();

                                        foreach (var padre in padres)
                                        {
                                            var i = padre.Index;
                                            procesados.Add(i);

                                            <!-- FILA DEL PADRE -->
                                            <tr class="bg-light bg-opacity-75 border-top">
                                                <td class="ps-4">
                                                    <input type="hidden" asp-for="PermisosPantalla[i].PantallaId" />
                                                    <input type="hidden" asp-for="PermisosPantalla[i].PantallaPadrId" />
                                                    <input type="hidden" asp-for="PermisosPantalla[i].NombrePantalla" />
                                                    <input type="hidden" asp-for="PermisosPantalla[i].Ruta" />
                                                    <input type="hidden" asp-for="PermisosPantalla[i].Icono" />
                                                    <input type="hidden" asp-for="PermisosPantalla[i].Orden" />

                                                    <div class="fw-bold text-dark d-flex align-items-center">
                                                        @if (!string.IsNullOrEmpty(Model.PermisosPantalla[i].Icono))
                                                        {
                                                            <i class="@Model.PermisosPantalla[i].Icono text-primary me-2" style="width: 20px; text-align: center;"></i>
                                                        }
                                                        @Model.PermisosPantalla[i].NombrePantalla
                                                    </div>
                                                </td>
                                                <td class="text-center"><div class="form-check form-check-inline m-0"><input asp-for="PermisosPantalla[i].Lectura" class="form-check-input shadow-sm" type="checkbox" /></div></td>
                                                <td class="text-center"><div class="form-check form-check-inline m-0"><input asp-for="PermisosPantalla[i].Creacion" class="form-check-input shadow-sm" type="checkbox" /></div></td>
                                                <td class="text-center"><div class="form-check form-check-inline m-0"><input asp-for="PermisosPantalla[i].Edicion" class="form-check-input shadow-sm" type="checkbox" /></div></td>
                                                <td class="pe-4 text-center"><div class="form-check form-check-inline m-0"><input asp-for="PermisosPantalla[i].Eliminacion" class="form-check-input shadow-sm" type="checkbox" /></div></td>
                                            </tr>

                                            // 3. Buscamos los hijos específicos de este padre
                                            var hijos = listaIndexada
                                                .Where(x => x.Item.PantallaPadrId == padre.Item.PantallaId)
                                                .ToList();

                                            foreach (var hijo in hijos)
                                            {
                                                var j = hijo.Index;
                                                procesados.Add(j);

                                                <!-- FILA DEL HIJO -->
                                                <tr>
                                                    <td class="ps-5">
                                                        <input type="hidden" asp-for="PermisosPantalla[j].PantallaId" />
                                                        <input type="hidden" asp-for="PermisosPantalla[j].PantallaPadrId" />
                                                        <input type="hidden" asp-for="PermisosPantalla[j].NombrePantalla" />
                                                        <input type="hidden" asp-for="PermisosPantalla[j].Ruta" />
                                                        <input type="hidden" asp-for="PermisosPantalla[j].Icono" />
                                                        <input type="hidden" asp-for="PermisosPantalla[j].Orden" />

                                                        <div class="fw-semibold text-dark d-flex align-items-center ms-3">
                                                            <i class="fas fa-level-up-alt fa-rotate-90 text-muted me-2" style="font-size: 0.8rem;"></i>
                                                            @Model.PermisosPantalla[j].NombrePantalla
                                                        </div>
                                                        <div class="text-muted ms-5" style="font-size: 0.80rem;">@Model.PermisosPantalla[j].Ruta</div>
                                                    </td>
                                                    <td class="text-center"><div class="form-check form-check-inline m-0"><input asp-for="PermisosPantalla[j].Lectura" class="form-check-input shadow-sm" type="checkbox" /></div></td>
                                                    <td class="text-center"><div class="form-check form-check-inline m-0"><input asp-for="PermisosPantalla[j].Creacion" class="form-check-input shadow-sm" type="checkbox" /></div></td>
                                                    <td class="text-center"><div class="form-check form-check-inline m-0"><input asp-for="PermisosPantalla[j].Edicion" class="form-check-input shadow-sm" type="checkbox" /></div></td>
                                                    <td class="pe-4 text-center"><div class="form-check form-check-inline m-0"><input asp-for="PermisosPantalla[j].Eliminacion" class="form-check-input shadow-sm" type="checkbox" /></div></td>
                                                </tr>
                                            }
                                        }

                                        // 4. Contingencia de seguridad: Renderizamos elementos sin padre para no romper el binding en el POST
                                        var faltantes = listaIndexada.Where(x => !procesados.Contains(x.Index)).ToList();
                                        foreach (var faltante in faltantes)
                                        {
                                            var k = faltante.Index;
                                            <tr>
                                                <td class="ps-5">
                                                    <input type="hidden" asp-for="PermisosPantalla[k].PantallaId" />
                                                    <input type="hidden" asp-for="PermisosPantalla[k].PantallaPadrId" />
                                                    <input type="hidden" asp-for="PermisosPantalla[k].NombrePantalla" />
                                                    <input type="hidden" asp-for="PermisosPantalla[k].Ruta" />
                                                    <input type="hidden" asp-for="PermisosPantalla[k].Icono" />
                                                    <input type="hidden" asp-for="PermisosPantalla[k].Orden" />

                                                    <div class="fw-semibold text-danger d-flex align-items-center ms-3">
                                                        <i class="fas fa-exclamation-circle me-2"></i> @Model.PermisosPantalla[k].NombrePantalla (Huérfano)
                                                    </div>
                                                </td>
                                                <td class="text-center"><div class="form-check form-check-inline m-0"><input asp-for="PermisosPantalla[k].Lectura" class="form-check-input shadow-sm" type="checkbox" /></div></td>
                                                <td class="text-center"><div class="form-check form-check-inline m-0"><input asp-for="PermisosPantalla[k].Creacion" class="form-check-input shadow-sm" type="checkbox" /></div></td>
                                                <td class="text-center"><div class="form-check form-check-inline m-0"><input asp-for="PermisosPantalla[k].Edicion" class="form-check-input shadow-sm" type="checkbox" /></div></td>
                                                <td class="pe-4 text-center"><div class="form-check form-check-inline m-0"><input asp-for="PermisosPantalla[k].Eliminacion" class="form-check-input shadow-sm" type="checkbox" /></div></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/seguridad/catalogo-roles" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-secondary">
                        <i class="fas fa-save me-1"></i>Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>