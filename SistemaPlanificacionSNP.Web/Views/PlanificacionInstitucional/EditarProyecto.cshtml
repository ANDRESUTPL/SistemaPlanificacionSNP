@model SistemaPlanificacionSNP.Web.Models.ProyectoInversionEditViewModel

@{
    ViewData["Title"] = "Editar Proyecto de Inversion";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="mb-1 fw-bold text-dark"><i class="fas fa-pen-to-square me-2 text-primary"></i>Editar Proyecto de Inversion</h3>
            <p class="text-muted mb-0 text-uppercase tracking-wider text-xs fw-bold">PEI-@Model.PlanEstrategicoId · PRY-@Model.ProyectoInversionId</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a href="/planificacion/institucional/@Model.PlanEstrategicoId" class="btn btn-light border shadow-sm px-4 fw-medium text-secondary">
                <i class="fas fa-arrow-left me-2"></i>Volver al Detalle
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-warning border-0"></div>
                    }

                    <form method="post" action="/planificacion/institucional/@Model.PlanEstrategicoId/proyectos/@Model.ProyectoInversionId/editar" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PlanEstrategicoId" />
                        <input type="hidden" asp-for="ProyectoInversionId" />

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="CodigoProyecto" class="form-label fw-medium text-sm"></label>
                                <input asp-for="CodigoProyecto" class="form-control fw-bold text-primary bg-light" readonly />
                                <span asp-validation-for="CodigoProyecto" class="text-danger text-sm"></span>
                            </div>

                            <div class="col-md-8">
                                <label asp-for="Monto" class="form-label fw-medium text-sm"></label>
                                <input asp-for="Monto" class="form-control" type="number" step="0.01" min="0.01" />
                                <span asp-validation-for="Monto" class="text-danger text-sm"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Nombre" class="form-label fw-medium text-sm"></label>
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger text-sm"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Estado" class="form-label fw-medium text-sm"></label>
                                <select asp-for="Estado" class="form-select">
                                    <option value="Formulacion">Formulacion</option>
                                    <option value="En Revision">En Revision</option>
                                    <option value="Aprobado">Aprobado</option>
                                    <option value="Inactivo">Inactivo</option>
                                </select>
                                <span asp-validation-for="Estado" class="text-danger text-sm"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="RespaldosEjecucion" class="form-label fw-medium text-sm"></label>
                                <input asp-for="RespaldosEjecucion" class="form-control" type="file" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                                <div class="form-text">Puede adjuntar varios respaldos de ejecución de hasta 10 MB cada uno.</div>
                                @if (Model.Respaldos.Count > 0)
                                {
                                    <div class="mt-3">
                                        <div class="text-muted text-xs text-uppercase fw-bold mb-2">Respaldos existentes</div>
                                        @foreach (var respaldo in Model.Respaldos)
                                        {
                                            <div class="small text-secondary"><i class="fas fa-paperclip me-2"></i>@respaldo.NombreArchivo</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a href="/planificacion/institucional/@Model.PlanEstrategicoId" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-secondary px-4 shadow-sm">
                                <i class="fas fa-save me-1"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
