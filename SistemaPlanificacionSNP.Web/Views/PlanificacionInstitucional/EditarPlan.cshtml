@model SistemaPlanificacionSNP.Web.Models.PlanEstrategicoEditViewModel

@{
    ViewData["Title"] = "Editar Plan Estratégico Institucional";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="mb-1 fw-bold text-dark"><i class="fas fa-pen-to-square text-primary me-2"></i>Editar PEI</h3>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">Actualiza la configuración del Plan Estratégico Institucional.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a href="/planificacion/institucional" class="btn btn-light border shadow-sm px-4 fw-medium text-secondary">
                <i class="fas fa-arrow-left me-2"></i>Volver
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white pt-4 pb-3 border-bottom px-4 d-flex align-items-center">
                    <div class="rounded-3 p-2 d-flex align-items-center justify-content-center me-3" style="background-color: #eff6ff; color: #3b82f6;">
                        <i class="fas fa-landmark fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Información del Plan</h5>
                </div>
                <div class="card-body p-4 p-xl-5">
                    <form method="post" action="/planificacion/institucional/@Model.PlanEstrategicoId/editar" id="formEditPEI">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PlanEstrategicoId" />

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 border-start border-4 border-danger shadow-sm rounded-3 mb-4 d-flex" role="alert">
                                <i class="fas fa-exclamation-circle mt-1 me-3 fs-5 text-danger"></i>
                                <div>
                                    <h6 class="fw-bold mb-1 text-danger">Revisa los campos</h6>
                                    <div asp-validation-summary="All" class="text-danger small mb-0 ps-3"></div>
                                </div>
                            </div>
                        }

                        <div class="mb-4">
                            <label asp-for="EntidadPublicaId" class="form-label fw-medium text-dark text-xs text-uppercase tracking-wider">Entidad Pública Responsable <span class="text-danger">*</span></label>
                            @if (Model.EntidadesDisponibles.Count > 0)
                            {
                                <select asp-for="EntidadPublicaId" class="form-select form-select-lg">
                                    <option value="">-- Seleccione la Institución --</option>
                                    @foreach (var ent in Model.EntidadesDisponibles.OrderBy(e => e.Nombre))
                                    {
                                        <option value="@ent.EntidadPublicaId">@ent.Nombre (@ent.Sigla)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    No existen entidades activas disponibles. Crea primero una entidad en Parametrización > Instituciones.
                                </div>
                            }
                            <span asp-validation-for="EntidadPublicaId" class="text-danger text-xs fw-medium mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PeriodoPlanificacionId" class="form-label fw-medium text-dark text-xs text-uppercase tracking-wider">Período de Planificación <span class="text-danger">*</span></label>
                            @if (Model.PeriodosDisponibles.Count > 0)
                            {
                                <select asp-for="PeriodoPlanificacionId" class="form-select form-select-lg" id="periodoSelect">
                                    <option value="">-- Seleccione el período --</option>
                                    @foreach (var periodo in Model.PeriodosDisponibles)
                                    {
                                        <option value="@periodo.PeriodoPlanificacionId" data-inicio="@periodo.FechaInicio.Year" data-fin="@periodo.FechaFin.Year">
                                            @periodo.Nombre (@periodo.FechaInicio.Year - @periodo.FechaFin.Year)
                                        </option>
                                    }
                                </select>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    No existen períodos activos. Crea primero un período en Parametrización > Instituciones.
                                </div>
                            }
                            <span asp-validation-for="PeriodoPlanificacionId" class="text-danger text-xs fw-medium mt-1 d-block"></span>
                            <div class="form-text" id="periodoPreview">Seleccione un período para derivar automáticamente los años del PEI.</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Estado" class="form-label fw-medium text-dark text-xs text-uppercase tracking-wider">Estado del Plan <span class="text-danger">*</span></label>
                            <select asp-for="Estado" class="form-select form-select-lg">
                                <option value="Borrador">Borrador</option>
                                <option value="Activo">Activo</option>
                                <option value="Inactivo">Inactivo</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger text-xs fw-medium mt-1 d-block"></span>
                        </div>

                        <hr class="border-light-subtle my-5">

                        <div class="d-flex justify-content-end gap-2">
                            <a href="/planificacion/institucional" class="btn btn-outline-secondary px-5 rounded-pill">Cancelar</a>
                            <button type="submit" class="btn btn-secondary px-5 rounded-pill shadow-sm" id="btnSubmit">
                                <i class="fas fa-save me-2"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function actualizarResumenPeriodo() {
            const select = document.getElementById('periodoSelect');
            const preview = document.getElementById('periodoPreview');
            if (!select || !preview) return;

            const option = select.options[select.selectedIndex];
            const inicio = option ? option.getAttribute('data-inicio') : null;
            const fin = option ? option.getAttribute('data-fin') : null;

            if (inicio && fin) {
                preview.textContent = `Rango derivado del período: ${inicio} - ${fin}.`;
                return;
            }

            preview.textContent = 'Seleccione un período para derivar automáticamente los años del PEI.';
        }

        document.getElementById('periodoSelect')?.addEventListener('change', actualizarResumenPeriodo);
        actualizarResumenPeriodo();

        document.getElementById('formEditPEI')?.addEventListener('submit', function () {
            if (typeof $ !== 'undefined' && $(this).valid()) {
                const btn = document.getElementById('btnSubmit');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Procesando...';
                }
            }
        });
    </script>
}
