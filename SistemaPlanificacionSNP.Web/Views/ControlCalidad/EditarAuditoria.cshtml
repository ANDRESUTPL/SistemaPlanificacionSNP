@model SistemaPlanificacionSNP.Web.Models.AuditoriaEditViewModel

@{
    ViewData["Title"] = "Editar Auditoria Anexa";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="mb-1 fw-bold text-dark"><i class="fas fa-pen-to-square me-2 text-primary"></i>Editar Auditoria Anexa</h3>
            <p class="text-muted mb-0 text-uppercase tracking-wider text-xs fw-bold">REV-@Model.RevisionId · AUD-@Model.AuditoriaId</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a href="/controlcalidad/revisiones/@Model.RevisionId" class="btn btn-light border shadow-sm px-4 fw-medium text-secondary">
                <i class="fas fa-arrow-left me-2"></i>Volver al Detalle
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-warning border-0"></div>
                    }

                    <form method="post" action="/controlcalidad/revisiones/@Model.RevisionId/auditorias/@Model.AuditoriaId/editar" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="RevisionId" />
                        <input type="hidden" asp-for="AuditoriaId" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Tipo" class="form-label fw-medium text-sm"></label>
                                <select asp-for="Tipo" class="form-select" required>
                                    <option value="">-- Seleccionar --</option>
                                    <option value="Interna">Auditoria Interna</option>
                                    <option value="Externa">Auditoria Externa</option>
                                    <option value="Seguimiento">Control de Seguimiento</option>
                                    <option value="Cumplimiento">Revision de Cumplimiento</option>
                                </select>
                                <span asp-validation-for="Tipo" class="text-danger text-sm"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Resultado" class="form-label fw-medium text-sm"></label>
                                <select asp-for="Resultado" class="form-select" required>
                                    <option value="">-- Seleccionar --</option>
                                    <option value="Conforme">Conforme (Aprobado)</option>
                                    <option value="Observado">Observado (Requiere ajustes)</option>
                                    <option value="No Conforme">No Conforme (Rechazado)</option>
                                </select>
                                <span asp-validation-for="Resultado" class="text-danger text-sm"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="FechaRegistro" class="form-label fw-medium text-sm"></label>
                                <input asp-for="FechaRegistro" class="form-control" type="datetime-local" value="@Model.FechaRegistro.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="FechaRegistro" class="text-danger text-sm"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="DocumentosAuditoria" class="form-label fw-medium text-sm"></label>
                                <input asp-for="DocumentosAuditoria" class="form-control" type="file" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                                <div class="form-text text-xs">Puede anexar documentos PDF, Word, Excel o imágenes de hasta 10 MB cada uno.</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a href="/controlcalidad/revisiones/@Model.RevisionId" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-secondary px-4 shadow-sm">
                                <i class="fas fa-save me-1"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>

                    <div class="border-top mt-4 pt-4">
                        <h6 class="fw-bold text-dark mb-3"><i class="fas fa-paperclip me-2 text-primary"></i>Documentos anexos</h6>
                        @if (Model.DocumentosExistentes.Count == 0)
                        {
                            <div class="text-muted text-sm bg-light rounded-3 p-3 border">No hay documentos anexos registrados para esta auditoría.</div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                                @foreach (var doc in Model.DocumentosExistentes.OrderByDescending(d => d.FechaCarga))
                                {
                                    <div class="list-group-item d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center">
                                        <div>
                                            <div class="fw-medium text-dark"><i class="fas fa-file-alt me-2 text-muted"></i>@doc.NombreArchivo</div>
                                            <div class="text-muted text-xs">@doc.FechaCarga.ToString("dd/MM/yyyy HH:mm") · @((doc.TamanoBytes / 1024.0).ToString("N1")) KB</div>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a class="btn btn-sm btn-outline-primary" href="/controlcalidad/revisiones/@Model.RevisionId/auditorias/@Model.AuditoriaId/documentos/@doc.AuditoriaDocumentoId">
                                                <i class="fas fa-download me-1"></i>Descargar
                                            </a>
                                            <form method="post" action="/controlcalidad/revisiones/@Model.RevisionId/auditorias/@Model.AuditoriaId/documentos/@doc.AuditoriaDocumentoId/eliminar" onsubmit="return confirm('¿Eliminar este documento?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-trash me-1"></i>Eliminar
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
